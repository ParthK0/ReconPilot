# ReconPilot Environment Configuration

# Database Configuration
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/reconpilot
# Alternatively, discrete parameters:
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=postgres
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# POSTGRES_DB=reconpilot

# Authentication
DEMO_API_KEY=reconpilot-demo-secret-key-2026

# AI / LLM Configuration
# Modes: "live" (calls live Gemini/OpenAI endpoints) or "offline" (deterministic offline simulation)
RECONPILOT_AI_MODE=live
GEMINI_API_KEY=
# OPENAI_API_KEY=sk-...
AI_MODEL=gemini-2.5-pro
AI_SPEND_CEILING_USD=5.00

# App Settings
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
PORT=8000
